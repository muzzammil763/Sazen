---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import Play from '../components/Play.astro';
import { apps, developerUrl, playUrl, icon, screen } from '../data/apps';
const heroApps = [apps[2], apps[0], apps[1]];
const filters = [{id:'all',label:'All apps', count:5},{id:'faith',label:'Faith & reflection',count:3},{id:'everyday',label:'Everyday tools',count:1},{id:'shopping',label:'Shopping & gifts',count:1}];
const schema = {'@context':'https://schema.org','@type':'Organization',name:'Sazen',url:Astro.site?.toString(),logo:new URL('/images/sazen-logo.png',Astro.site).toString(),sameAs:[developerUrl]};
---
<Base>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <section class="hero container">
    <div class="hero-copy">
      <span class="eyebrow"><span class="status-dot"></span> A little Sazen in your day</span>
      <h1>Thoughtful apps.<br />Everyday<br /><span class="underline">possibilities.</span></h1>
      <p class="lead">For your faith, your finances, and the little things in between. Apps made with care, to make every day a little easier.</p>
      <a class="btn btn-primary" href="#apps">Find your next app <Arrow /></a>
      <div class="hero-note"><div class="icon-stack">{apps.map(app => <img src={icon(app)} alt="" width="32" height="32" />)}</div><span>Five apps. One thoughtful family.</span></div>
    </div>
    <div class="hero-stage" aria-label="A preview of the Sazen app family">
      <span class="stage-orbit orbit-one" aria-hidden="true"></span><span class="stage-orbit orbit-two" aria-hidden="true"></span>
      <span class="stage-label top-label"><span class="tiny-star">✦</span> Made for your everyday</span>
      <div class="hero-phones">{heroApps.map((app,i) => <a href={`#${app.slug}`} class={`hero-phone phone-${i}`} aria-label={`Explore ${app.name}`}><img src={screen(app)} alt={`${app.name} app home screen`} width="720" height="1560" fetchpriority={i===1 ? 'high' : 'auto'} /></a>)}</div>
      <span class="stage-label bottom-label"><img src="/images/sazen-logo.png" alt="" width="28" height="28" /> Different apps. The same care.</span>
      <span class="stage-spark spark-one" aria-hidden="true">✦</span><span class="stage-spark spark-two" aria-hidden="true">✳</span>
    </div>
  </section>
  <div class="app-ribbon"><div class="container ribbon-inner">{apps.map(app => <a href={`#${app.slug}`}><img src={icon(app)} width="29" height="29" alt="" /><span>{app.name}</span><span class="ribbon-sub">{app.slug==='99-names'?'Asmaul Husna':app.subtitle}</span></a>)}</div></div>

  <section id="apps" class="section container">
    <div class="section-heading"><div><span class="eyebrow">The Sazen collection</span><h2>A place for every<br />part of your day.</h2></div><p>Different needs. The same attention to detail.<br />Meet the apps, and find the one for you.</p></div>
    <div class="filters" role="group" aria-label="Filter apps by category" hidden>{filters.map(f => <button data-filter={f.id} aria-pressed={f.id==='all'}>{f.label}<span>{f.count}</span></button>)}</div>
    <p class="sr-only" id="filter-status" aria-live="polite"></p>
    <div class="app-grid">
      {apps.map((app,index) => (
        <article id={app.slug} class={`app-card ${app.color}`} data-category={app.filter}>
          <a class="card-stage" href={`/apps/${app.slug}`} aria-label={`Explore ${app.name} and its screenshots`}>
            <span class="stage-category">{app.category}</span><span class="stage-index">0{index+1}</span>
            <span class="card-stage-title">{app.headline}</span>
            <div class="card-phones"><img class="card-phone first" src={screen(app)} alt={`${app.name}: ${app.captions[0]}`} width="720" height="1560" loading="lazy" /><img class="card-phone second" src={screen(app,2)} alt={`${app.name}: ${app.captions[1]}`} width="720" height="1560" loading="lazy" /></div>
            <span class="preview-link">Take a closer look <Arrow /></span>
          </a>
          <div class="card-content">
            <div class="app-title"><img src={icon(app)} width="54" height="54" alt={`${app.name} icon`} loading="lazy" /><div><h3><a href={`/apps/${app.slug}`}>{app.name}</a></h3><span>{app.subtitle}</span></div></div>
            <p>{app.description}</p>
            {app.slug==='budget-ai' && <small class="pricing-note">Free manual tracking · 5 free AI messages/month, then paid</small>}
            <div class="card-actions"><a class="btn btn-primary" href={playUrl(app)} target="_blank" rel="noopener noreferrer" aria-label={`${app.slug === 'budget-ai' ? 'Check availability of' : 'Get'} ${app.name} on Google Play`}><Play /> {app.slug === 'budget-ai' ? 'Check Google Play' : 'Google Play'}</a><a class="text-link" href={app.website} target={app.website.startsWith('https')?'_blank':undefined} rel={app.website.startsWith('https')?'noopener noreferrer':undefined} aria-label={`Visit ${app.name} website`}>Visit website <Arrow /></a></div>
          </div>
        </article>
      ))}
      <aside class="collection-note"><div class="note-mark" aria-hidden="true">✳</div><span class="eyebrow">Made with care by Sazen</span><h3>A little less friction.<br />A little more life.</h3><p>From your first prayer to your last expense of the day. There’s a little room for Sazen in your routine.</p><a class="text-link" href={developerUrl} target="_blank" rel="noopener noreferrer">Explore Sazen on Google Play <Arrow /></a><div class="note-icons" aria-hidden="true">{apps.map(app=><img src={icon(app)} width="44" height="44" alt="" loading="lazy" />)}</div></aside>
    </div>
  </section>

  <section id="about" class="about-section"><div class="container about-grid"><div class="about-art"><img src="/images/sazen-banner.webp" alt="Sazen — Apps · Games, the official Sazen developer banner" width="1440" height="810" loading="lazy" /></div><div class="about-copy"><span class="eyebrow">Hello. We’re Sazen.</span><h2>Useful by nature.<br />Thoughtful by design.</h2><p>We make apps for the things that fill your days. A moment of reflection. A clearer picture of your spending. A gift that says you care.</p><p>Each app has its own purpose. Together, they share one simple idea: everyday things deserve a little extra thought.</p><a class="text-link" href={developerUrl} target="_blank" rel="noopener noreferrer">Meet Sazen on Google Play <Arrow /></a></div></div></section>

  <section id="questions" class="section container questions"><div><span class="eyebrow">Good to know</span><h2>A few little<br />details.</h2><p>Finding an app is the easy part.<br />Here’s what comes next.</p></div><div class="faq-list">
    <details><summary>Where can I download the apps?<span aria-hidden="true">+</span></summary><p>Each app has its own Google Play link above. You can also browse the <a href={developerUrl} target="_blank" rel="noopener noreferrer">Sazen developer page</a>. Store availability can vary by country and device.</p></details>
    <details><summary>Are 99 Names and Asmaul Husna the same app?<span aria-hidden="true">+</span></summary><p>Yes. The app’s full name is “99 Names – Asmaul Husna.” You’ll find both names together in its listing and on its website.</p></details>
    <details><summary>Are all the apps free?<span aria-hidden="true">+</span></summary><p>Check each Google Play listing for its current pricing and in-app purchases. Budget AI’s manual tracking is free. Its AI features are paid, with 5 free AI messages each month. FM Crafts products are purchased separately.</p></details>
    <details><summary>How do I get help with an app?<span aria-hidden="true">+</span></summary><p>Open the app’s website using the links above, or go to “App support” on its Google Play listing. That takes you to the right support and privacy information for that app.</p></details>
    <details><summary>Where can I see more screenshots?<span aria-hidden="true">+</span></summary><p>Select any app preview above to open its Sazen page, with a gallery of real screenshots. Tap a screenshot to enlarge it. Each app’s own website and Google Play listing have more details.</p></details>
  </div></section>
  <section class="closing container"><span class="eyebrow">Your next little everyday companion</span><h2>Make room for<br />something useful.</h2><a href="#apps" class="btn btn-primary">Explore our apps <Arrow /></a><span class="closing-star" aria-hidden="true">✳</span></section>
  <script>
    const filters = document.querySelector<HTMLElement>('.filters');
    if (filters) filters.hidden = false;
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.addEventListener('click', () => {
      const selected = button.dataset.filter;
      document.querySelectorAll('[data-filter]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      let visible = 0;
      document.querySelectorAll<HTMLElement>('[data-category]').forEach(card => {
        card.hidden = selected !== 'all' && card.dataset.category !== selected;
        if (!card.hidden) visible++;
      });
      const note = document.querySelector<HTMLElement>('.collection-note');
      if (note) note.hidden = selected !== 'all';
      document.querySelector('#filter-status')!.textContent = `${visible} ${visible === 1 ? 'app' : 'apps'} shown`;
    }));
    // Deep links must remain useful after a visitor has selected a filter.
    function revealLinkedApp() {
      if (document.getElementById(location.hash.slice(1))?.matches('[data-category][hidden]')) {
        document.querySelector<HTMLButtonElement>('[data-filter="all"]')?.click();
        document.getElementById(location.hash.slice(1))?.scrollIntoView();
      }
    }
    window.addEventListener('hashchange', revealLinkedApp);
  </script>
</Base>
